# Local Supabase stack: run `supabase start --workdir ../../infra` from apps/web,
# or `supabase status --workdir infra` from the repo root, to get these values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# apps/ml-service, run locally: uvicorn main:app --reload --port 8000
ML_SERVICE_URL=http://localhost:8000

# Encrypts BYOK provider API keys at rest (AES-256-GCM). Generate your own
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BYOK_ENCRYPTION_KEY=
